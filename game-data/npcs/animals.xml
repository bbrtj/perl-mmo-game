<?xml version="1.0" encoding="UTF-8"?>
<npcs requires="races">
	<npc id="rat" name="Rat">
		<translation lang="pl">
			<name>Szczur</name>
			<desc>Niewielki, zazwyczaj niegroźny szkodnik.</desc>
		</translation>
		<translation lang="en">
			<name>Rat</name>
			<desc>A small, usually harmless pest.</desc>
		</translation>

		<uses lore="race">Animal</uses>

		<visuals>
			<model>images/actors/rat.png</model>
		</visuals>

		<stat_bonuses>
			<stat lore="primary_stat" lore-key="Strength">-5</stat>
			<stat lore="primary_stat" lore-key="Dexterity">-10</stat>
			<stat lore="primary_stat" lore-key="Constitution">-10</stat>

			<stat lore="secondary_stat" lore-key="Might">1</stat>
			<stat lore="secondary_stat" lore-key="Accuracy">1</stat>
			<stat lore="secondary_stat" lore-key="Stamina">1</stat>
		</stat_bonuses>

		<level>1</level>
		<health_multiplier>0.3</health_multiplier>
		<respawn_time>60</respawn_time>
	</npc>
	<npc id="bograt" name="Bog rat">
		<translation lang="pl">
			<name>Szczur Bagienny</name>
			<desc>Większy gatunek szczura, bardziej przystosowana do życia w skrajnym środowisku.</desc>
		</translation>
		<translation lang="en">
			<name>Bog Rat</name>
			<desc>A larger species of the rat, better adapted to life in harsh environment.</desc>
		</translation>

		<uses lore="race">Animal</uses>

		<visuals>
			<model>images/actors/bog_rat.png</model>
		</visuals>

		<stat_bonuses>
			<stat lore="primary_stat" lore-key="Strength">-3</stat>
			<stat lore="primary_stat" lore-key="Dexterity">-8</stat>
			<stat lore="primary_stat" lore-key="Constitution">-8</stat>

			<stat lore="secondary_stat" lore-key="Might">2</stat>
			<stat lore="secondary_stat" lore-key="Accuracy">2</stat>
			<stat lore="secondary_stat" lore-key="Stamina">2</stat>
		</stat_bonuses>

		<level>2</level>
		<health_multiplier>0.3</health_multiplier>
		<respawn_time>60</respawn_time>
	</npc>
</npcs>

