<?xml version="1.0" encoding="UTF-8"?>
<classes requires="races">
	<class id="knight" name="Knight">
		<translation lang="pl">
			<name>Rycerz</name>
			<desc>Rycerze to nieustępliwi i cnotliwi wojownicy. Odziani w ciężką zbroję są w staniestawić czoła najsilniejszym przeciwnikom.</desc>
		</translation>
		<translation lang="en">
			<name>Knight</name>
			<desc>Knights are unyielding and virtuous warriors. Clad in heavy armor they are able to face the mightiest of foes.</desc>
		</translation>

		<uses lore="race">Elf</uses>

		<visuals>
			<model>images/actors/knight.png</model>
		</visuals>

		<stat_bonuses>
			<stat lore="primary_stat" lore-key="Strength">4</stat>
			<stat lore="primary_stat" lore-key="Constitution">6</stat>
			<stat lore="primary_stat" lore-key="Charisma">2</stat>

			<stat lore="secondary_stat" lore-key="Might">1</stat>
			<stat lore="secondary_stat" lore-key="Resilience">2</stat>
			<stat lore="secondary_stat" lore-key="Willpower">2</stat>
			<stat lore="secondary_stat" lore-key="Stamina">2</stat>
			<stat lore="secondary_stat" lore-key="Persistence">1</stat>
			<stat lore="secondary_stat" lore-key="Vigor">1</stat>
		</stat_bonuses>

		<health_multiplier>1.4</health_multiplier>
		<energy_multiplier>1.5</energy_multiplier>
	</class>
</classes>

