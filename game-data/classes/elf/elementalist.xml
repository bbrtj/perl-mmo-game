<?xml version="1.0" encoding="UTF-8"?>
<classes requires="races">
	<class id="elem" name="Elementalist">
		<translation lang="pl">
			<name>Mag żywiołów</name>
			<desc>Magowie żywiołów posiadają władzę nad destrukcyjnymi siłami natury, co umożliwia im siać spustoszenie na polu bitwy.</desc>
		</translation>
		<translation lang="en">
			<name>Elementalist</name>
			<desc>Elementalists wield power over the destructive forces of nature, allowing them to wreak havoc on the battlefield.</desc>
		</translation>

		<uses lore="race">Elf</uses>

		<visuals>
			<model>images/actors/knight.png</model>
		</visuals>

		<stat_bonuses>
			<stat lore="primary_stat" lore-key="Wisdom">8</stat>
			<stat lore="primary_stat" lore-key="Charisma">4</stat>

			<stat lore="secondary_stat" lore-key="Accuracy">1</stat>
			<stat lore="secondary_stat" lore-key="Acumen">2</stat>
			<stat lore="secondary_stat" lore-key="Stamina">1</stat>
			<stat lore="secondary_stat" lore-key="Persistence">2</stat>
			<stat lore="secondary_stat" lore-key="Vigor">1</stat>
		</stat_bonuses>

		<health_multiplier>0.9</health_multiplier>
		<energy_multiplier>2</energy_multiplier>
	</class>
</classes>

