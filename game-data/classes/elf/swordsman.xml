<?xml version="1.0" encoding="UTF-8"?>
<classes requires="races">
	<class id="sword" name="Swordsman">
		<translation lang="pl">
			<name>Szermierz</name>
			<desc>Szermierze są doskonali w walce w zwarciu. Wiedzą dokładnie gdzie i kiedy uderzyć, a ich ciosy cechuje niesamowita precyzja.</desc>
		</translation>
		<translation lang="en">
			<name>Swordsman</name>
			<desc>Swordsmen excel in close combat. They know exactly where and when to strike, and their blows are marked by uncanny precision.</desc>
		</translation>

		<uses lore="race">Elf</uses>

		<visuals>
			<model>images/actors/knight.png</model>
		</visuals>

		<stat_bonuses>
			<stat lore="primary_stat" lore-key="Strength">4</stat>
			<stat lore="primary_stat" lore-key="Dexterity">3</stat>
			<stat lore="primary_stat" lore-key="Constitution">3</stat>
			<stat lore="primary_stat" lore-key="Wisdom">1</stat>
			<stat lore="primary_stat" lore-key="Luck">1</stat>

			<stat lore="secondary_stat" lore-key="Might">2</stat>
			<stat lore="secondary_stat" lore-key="Accuracy">1</stat>
			<stat lore="secondary_stat" lore-key="Resilience">1</stat>
			<stat lore="secondary_stat" lore-key="Willpower">1</stat>
			<stat lore="secondary_stat" lore-key="Stamina">2</stat>
			<stat lore="secondary_stat" lore-key="Vigor">1</stat>
		</stat_bonuses>

		<health_multiplier>1.2</health_multiplier>
	</class>
</classes>

