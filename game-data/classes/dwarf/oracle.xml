<?xml version="1.0" encoding="UTF-8"?>
<classes requires="races">
	<class id="oracle" name="Oracle">
		<translation lang="pl">
			<name>Wyrocznia</name>
			<desc>Wyrocznie mają dar przepowiadania przyszłości oraz są duchowymi liderami swoich społeczności. Ich wsparcie pomaga w wytrwaniu na polu bitwy.</desc>
		</translation>
		<translation lang="en">
			<name>Oracle</name>
			<desc>Oracles possess the gift of divination and serve as spiritual leaders of their communities. Their support helps endure on the battlefield.</desc>
		</translation>

		<uses lore="race">Dwarf</uses>

		<visuals>
			<model>images/actors/knight.png</model>
		</visuals>

		<stat_bonuses>
			<stat lore="primary_stat" lore-key="Wisdom">4</stat>
			<stat lore="primary_stat" lore-key="Charisma">8</stat>

			<stat lore="secondary_stat" lore-key="Acumen">1</stat>
			<stat lore="secondary_stat" lore-key="Resilience">1</stat>
			<stat lore="secondary_stat" lore-key="Willpower">1</stat>
			<stat lore="secondary_stat" lore-key="Stamina">1</stat>
			<stat lore="secondary_stat" lore-key="Persistence">1</stat>
			<stat lore="secondary_stat" lore-key="Vigor">2</stat>
		</stat_bonuses>

		<health_multiplier>0.8</health_multiplier>
		<energy_multiplier>2.2</energy_multiplier>
	</class>
</classes>

