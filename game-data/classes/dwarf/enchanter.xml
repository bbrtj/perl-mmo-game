<?xml version="1.0" encoding="UTF-8"?>
<classes requires="races">
	<class id="ench" name="Enchanter">
		<translation lang="pl">
			<name>Zaklinacz</name>
			<desc>Zaklinacze specjalizują się w nadawaniu przedmiotom magicznych właściwości. Ta tajemna sztuka przekazywana jest jedynie tradycją ustną.</desc>
		</translation>
		<translation lang="en">
			<name>Enchanter</name>
			<desc>Enchanters specialize in bestowing magical properties upon items. This arcane art is passed down only through oral tradition.</desc>
		</translation>

		<uses lore="race">Dwarf</uses>

		<visuals>
			<model>images/actors/knight.png</model>
		</visuals>

		<stat_bonuses>
			<stat lore="primary_stat" lore-key="Wisdom">6</stat>
			<stat lore="primary_stat" lore-key="Charisma">6</stat>

			<stat lore="secondary_stat" lore-key="Acumen">1</stat>
			<stat lore="secondary_stat" lore-key="Resilience">1</stat>
			<stat lore="secondary_stat" lore-key="Willpower">1</stat>
			<stat lore="secondary_stat" lore-key="Stamina">1</stat>
			<stat lore="secondary_stat" lore-key="Persistence">2</stat>
			<stat lore="secondary_stat" lore-key="Vigor">2</stat>
		</stat_bonuses>

		<energy_multiplier>2</energy_multiplier>
	</class>
</classes>

