<?xml version="1.0" encoding="UTF-8"?>
<classes requires="races">
	<class id="illu" name="Illusionist">
		<translation lang="pl">
			<name>Iluzjonista</name>
			<desc>Iluzjonści kształtują rzeczywistość według własnej woli. Poziom zaawansowania ich sztuczek czyni je nieodróżnialnymi od magii.</desc>
		</translation>
		<translation lang="en">
			<name>Illusionist</name>
			<desc>Illusionists shape reality according to their own will. The level of sophistication of their tricks makes them indistinguishable from magic.</desc>
		</translation>

		<uses lore="race">Human</uses>

		<visuals>
			<model>images/actors/knight.png</model>
		</visuals>

		<stat_bonuses>
			<stat lore="primary_stat" lore-key="Wisdom">6</stat>
			<stat lore="primary_stat" lore-key="Charisma">6</stat>

			<stat lore="secondary_stat" lore-key="Acumen">1</stat>
			<stat lore="secondary_stat" lore-key="Resilience">1</stat>
			<stat lore="secondary_stat" lore-key="Willpower">1</stat>
			<stat lore="secondary_stat" lore-key="Stamina">1</stat>
			<stat lore="secondary_stat" lore-key="Persistence">2</stat>
			<stat lore="secondary_stat" lore-key="Vigor">2</stat>
		</stat_bonuses>

		<health_multiplier>0.9</health_multiplier>
		<energy_multiplier>2</energy_multiplier>
	</class>
</classes>

